set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(AARCH64_SYSROOT "" CACHE PATH "Debian arm64 Pi sysroot")
set(AARCH64_CC "aarch64-linux-gnu-gcc" CACHE STRING "AArch64 Linux C compiler")
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES AARCH64_SYSROOT AARCH64_CC)
if(NOT AARCH64_SYSROOT)
    message(FATAL_ERROR "Set AARCH64_SYSROOT to an arm64 Linux sysroot")
endif()

set(CMAKE_C_COMPILER "${AARCH64_CC}")
set(CMAKE_SYSROOT "${AARCH64_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH "${AARCH64_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

find_program(QEMU_AARCH64 qemu-aarch64)
if(QEMU_AARCH64)
    set(CMAKE_CROSSCOMPILING_EMULATOR "${QEMU_AARCH64};-L;${AARCH64_SYSROOT}")
endif()
