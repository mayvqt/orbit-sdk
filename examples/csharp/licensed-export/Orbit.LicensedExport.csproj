<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreConfigFile>$(MSBuildThisFileDirectory)../../../sdk/csharp/NuGet.Config</RestoreConfigFile>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OrbitLocalDevelopment)' == 'true'">
    <DefineConstants>$(DefineConstants);ORBIT_LOCAL_DEVELOPMENT</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../sdk/csharp/Orbit.Sdk/Orbit.Sdk.csproj" />
  </ItemGroup>
</Project>
