@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
# Bounded request deadlines require libcurl built with CURL_VERSION_ASYNCHDNS.
find_dependency(CURL 8.0)
find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
find_dependency(Threads)
if(@ORBIT_JSONCPP_USE_CONFIG@)
    find_dependency(@ORBIT_JSONCPP_PACKAGE@ 1.9.5 CONFIG)
else()
    find_dependency(PkgConfig)
    pkg_check_modules(JSONCPP REQUIRED IMPORTED_TARGET jsoncpp>=1.9.5)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/OrbitSdkTargets.cmake")
